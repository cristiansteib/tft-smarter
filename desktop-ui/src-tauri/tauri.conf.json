{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFT Smarter",
  "version": "0.1.0",
  "identifier": "dev.tftsmarter.desktop",
  "build": {
    "beforeDevCommand": "npm start -- --port 4200",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/desktop-ui/browser"
  },
  "app": {
    "windows": [
      { "title": "TFT Smarter", "width": 1100, "height": 760, "minWidth": 900, "minHeight": 620 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
